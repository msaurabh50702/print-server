[Unit]
Description=Pi Print Server (web printing for the home network)
After=network-online.target cups.service
Wants=network-online.target cups.service

[Service]
Type=simple
User=__USER__
WorkingDirectory=__DIR__
EnvironmentFile=-/etc/default/print-server
ExecStart=__DIR__/.venv/bin/python run.py
Restart=on-failure
RestartSec=3
# Allow listening on port 80 without running as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
